/* Apollo V1 wiring is defined by docs/hardware.md. */
/ {
    chosen {
        /delete-property/ zephyr,code-partition;
    };

    /* Input polarity is not assumed by the raw-level key test. */
    fct_keys {
        compatible = "gpio-keys";
        fct_key_up: key_up { gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>; };
        fct_key2: key2 { gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>; };
        fct_key1: key1 { gpios = <&gpioh 2 GPIO_ACTIVE_HIGH>; };
        fct_key0: key0 { gpios = <&gpioh 3 GPIO_ACTIVE_HIGH>; };
    };
};

&flash0 {
    /delete-node/ partitions;
};

&red_led {
    gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
    label = "DS0";
};

&green_led {
    gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
    label = "DS1";
};

/* External SDRAM needs FMC initialization before it may be used. */
&sdram2 {
    status = "disabled";
};

/* hardware.md: PA11 RX / PA12 TX, selected by P10 instead of USB. */
&fdcan1 {
    pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
    pinctrl-names = "default";
    clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
             <&rcc STM32_SRC_HSE FDCAN_SEL(0)>;
    clk-divider = <1>;
    bitrate = <500000>;
    status = "okay";
};

/* Verified against stm32h743iitx-pinctrl.dtsi. */
&pinctrl {
    fct_i2c2_scl_ph4: fct_i2c2_scl_ph4 {
        pinmux = <STM32_PINMUX('H', 4, AF4)>;
        bias-pull-up;
        drive-open-drain;
    };
    fct_i2c2_sda_ph5: fct_i2c2_sda_ph5 {
        pinmux = <STM32_PINMUX('H', 5, AF4)>;
        bias-pull-up;
        drive-open-drain;
    };
};

&i2c2 {
    pinctrl-0 = <&fct_i2c2_scl_ph4 &fct_i2c2_sda_ph5>;
    pinctrl-names = "default";
    clock-frequency = <100000>;
    status = "okay";
};

/* Internal RNG for lwIP random numbers; no additional board pins are used. */
&clk_hsi48 {
    status = "okay";
};

&rng {
    status = "okay";
};
